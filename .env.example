# Docker Compose environment (copy to .env and fill real values)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/socialplatform?retryWrites=true&w=majority

JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=1h
REFRESH_SECRET=another_secret_change_me
REFRESH_EXPIRES_IN=30d

CLIENT_URL=http://localhost

# Cloudinary
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx

# Email (Nodemailer) - leave blank in dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=